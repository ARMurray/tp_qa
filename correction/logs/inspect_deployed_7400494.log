  199: def build_discharge_features(treatment_ids: set) -> pd.DataFrame:
  200:     df = pd.read_csv(
  201:         C.CWNS_DIR / "DISCHARGES.csv",
  202:         names=["CWNS_ID", "FACILITY_ID", "STATE_CODE", "DISCHARGE_TYPE",
  203:                "PRESENT_DISCHARGE_PERCENTAGE", "PROJECTED_DISCHARGE_PERCENTAGE",
  204:                "DISCHARGES_TO"],
  205:         header=0, dtype={"CWNS_ID": str}, encoding="latin1",
  206:     )
  207:     df = df[df["CWNS_ID"].isin(treatment_ids)]
  208: 
  209:     def agg(g):
  210:         surf = g["DISCHARGE_TYPE"] == "Outfall To Surface Waters"
  211:         return pd.Series(dict(
  212:             surface_water_discharge=bool(surf.any()),
  213:             surface_water_pct=float(g.loc[surf, "PRESENT_DISCHARGE_PERCENTAGE"].sum()),
  214:             ocean_discharge=bool((g["DISCHARGE_TYPE"] == "Ocean Discharge").any()),
  215:             cso_discharge=bool((g["DISCHARGE_TYPE"] == "CSO Discharge").any()),
  216:             requires_npdes=bool(g["DISCHARGE_TYPE"].isin([
  217:                 "Outfall To Surface Waters", "Ocean Discharge",
  218:                 "CSO Discharge", "Overland Flow With Discharge"]).any()),
  219:             any_reuse=bool(g["DISCHARGE_TYPE"].str.startswith("Reuse:", na=False).any()),
  220:             n_discharge_types=g["DISCHARGE_TYPE"].nunique(),
  221:         ))
  222: 
  223:     return df.groupby("CWNS_ID").apply(agg, include_groups=False).reset_index()
